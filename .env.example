# Copy to .env and fill in. Never commit .env.

# --- App database (docker-compose postgres) ---
DB_NAME=thoughttrace
DB_USER=thoughttrace
DB_PASSWORD=thoughttrace

# --- Judge0 internal credentials ---
JUDGE0_DB_PASSWORD=judge0
JUDGE0_REDIS_PASSWORD=judge0

# --- Backend ---
DB_URL=jdbc:postgresql://localhost:5432/thoughttrace
JUDGE0_URL=http://localhost:2358
JWT_SECRET=                  # base64-encoded 256-bit secret
JWT_EXPIRATION_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# --- AI (Phase 2) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
